<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GapFinder | System Admin Portal</title>
    <!-- GapFinder Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* --- RESET & LAYOUT --- */
        body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; color: #333; line-height: 1.6; overflow-x: hidden; }
        a { text-decoration: none; }

        /* --- NAVBAR --- */
        .navbar-custom { background: white; padding: 20px 5%; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 15px rgba(0,0,0,0.03); position: sticky; top: 0; z-index: 1000; }
        .brand { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: #162622; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .brand span { color: #dc3545; } /* Red accent for Admin */
        .nav-links { display: flex; align-items: center; gap: 15px; }
        .nav-separator { border-left: 1px solid #eee; height: 20px; margin: 0 5px; }
        .nav-links a, .nav-links span { color: #555; font-weight: 500; transition: color 0.3s; }
        .nav-links a:hover { color: #dc3545; }
        .btn-outline { border: 2px solid #dc3545; color: #dc3545 !important; padding: 6px 15px; border-radius: 8px; font-weight: 600; transition: 0.3s; font-size: 0.9rem;}
        .btn-outline:hover { background: rgba(220, 53, 69, 0.1); }
        
        /* --- DASHBOARD UI --- */
        .dashboard-container { margin-top: 50px; margin-bottom: 60px; }
        .gf-card { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #f0f2f5; height: 100%; border-top: 4px solid #dc3545; }
        .gf-card h5 { font-family: 'Montserrat', sans-serif; color: #162622; font-weight: 700; font-size: 1.2rem; border-bottom: 2px solid #f0f2f5; padding-bottom: 15px; margin-bottom: 20px;}
        
        .form-control, .form-select { border-radius: 8px; padding: 10px 15px; border: 1px solid #dee2e6; }
        .form-control:focus, .form-select:focus { border-color: #dc3545; box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25); }
        
        .btn-danger-custom { background: #dc3545; color: white; padding: 10px 20px; border-radius: 8px; font-weight: 600; border: none; width: 100%; transition: 0.3s; }
        .btn-danger-custom:hover { transform: translateY(-2px); background: #c82333; color: white; }
        
        /* Custom Table Styling */
        .table { font-size: 0.9rem; }
        .table thead th { background-color: #f8f9fa; color: #555; border-bottom: 2px solid #dee2e6; font-weight: 600;}
        .table tbody td { vertical-align: middle; }
    </style>
</head>
<body>

    <nav class="navbar-custom">
        <a href="/admin" class="brand">
            <i class="fa-solid fa-shield-halved" style="color: #dc3545;"></i>
            Gap<span>Finder</span>
        </a>
        <div class="nav-links">
            <span class="d-none d-md-inline"><i class="fa-solid fa-user-shield me-2"></i>Admin Portal</span>
            <div class="nav-separator d-none d-md-block"></div>
            <a href="/profile/security"><i class="fa-solid fa-key me-1"></i> Security</a>
            <a href="/auth/logout" class="btn-outline"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
        </div>
    </nav>

    <div class="container dashboard-container">
        <div class="mb-4">
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 800; color: #162622;">System Administrator Portal</h4>
        </div>

        <!-- Dynamic Feedback Alerts -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i><%= success %></div>
        <% } %>

        <div class="row g-4">
            <!-- Left Column: Privilege Management -->
            <!-- Left Column: Privilege Management -->
            <div class="col-md-4">
                
                <!-- PROMOTION CARD -->
                <div class="gf-card mb-4" style="border-top: 4px solid #198754;">
                    <h5><i class="fa-solid fa-arrow-up text-success me-2"></i> Promote Tutor</h5>
                    <p class="text-muted" style="font-size: 0.85rem;">Elevate a Tutor (Role B) to a higher privilege level.</p>
                    
                    <form action="/admin/promote" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select Tutor</label>
                            <select name="targetUsername" class="form-select" required>
                                <option value="" disabled selected>Choose a tutor...</option>
                                <% if (typeof tutors !== 'undefined' && tutors.length > 0) { %>
                                    <% tutors.forEach(function(u) { %>
                                        <option value="<%= u.username %>"><%= u.username %></option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="" disabled>No tutors available</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Promote To</label>
                            <select name="newRole" class="form-select" required>
                                <option value="Role A" selected>Coordinator (Role A)</option>
                                <option value="Administrator">Administrator</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100 fw-bold">Promote User</button>
                    </form>
                </div>

                <!-- DEMOTION CARD -->
                <div class="gf-card" style="border-top: 4px solid #dc3545;">
                    <h5><i class="fa-solid fa-arrow-down text-danger me-2"></i> Demote Coordinator</h5>
                    <p class="text-muted" style="font-size: 0.85rem;">Revoke Coordinator (Role A) privileges.</p>
                    
                    <form action="/admin/promote" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select Coordinator</label>
                            <select name="targetUsername" class="form-select" required>
                                <option value="" disabled selected>Choose a coordinator...</option>
                                <% if (typeof coordinators !== 'undefined' && coordinators.length > 0) { %>
                                    <% coordinators.forEach(function(u) { %>
                                        <option value="<%= u.username %>"><%= u.username %></option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="" disabled>No coordinators available</option>
                                <% } %>
                            </select>
                        </div>
                        <!-- Hidden input explicitly locking the demotion to Role B -->
                        <input type="hidden" name="newRole" value="Role B">
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold">Demote to Tutor</button>
                    </form>
                </div>

            </div>
            
            <!-- Right Column: Audit Logs -->
            <!-- Right Column: Audit Logs -->
            <div class="col-md-8">
                <div class="gf-card">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <h5 class="mb-0 border-0 pb-0"><i class="fa-solid fa-list-check me-2"></i> System Audit Logs</h5>
                        
                        <!-- Form to clear logs -->
                        <form action="/admin/logs/clear" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete all system logs? This action cannot be undone.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash-can me-1"></i> Clear Logs</button>
                        </form>
                    </div>

                    <div class="table-responsive mt-3" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover mb-0">
                            <thead style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Event Type</th>
                                    <th>Admin User</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                                    <% logs.forEach(function(log) { %>
                                        <tr>
                                            <td style="font-size: 0.85rem;" class="text-muted">
                                                <%= new Date(log.timestamp).toLocaleString() %>
                                            </td>
                                            <td><span class="badge <%= log.badgeColor %>"><%= log.eventType %></span></td>
                                            <td class="fw-medium"><%= log.userIdentifier %></td>
                                            <td style="font-size: 0.9rem;"><%= log.details %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="fa-solid fa-folder-open mb-2 fs-4 d-block"></i>
                                            No system logs found.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GapFinder | Update Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; color: #333; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .gf-card { background: white; border-radius: 15px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #f0f2f5; width: 100%; max-width: 480px; border-top: 4px solid #00aeef; }
        .brand { font-family: 'Montserrat', sans-serif; font-size: 1.8rem; color: #162622; font-weight: 700; text-align: center; margin-bottom: 25px; display: block; text-decoration: none; }
        .brand span { color: #00aeef; }
        .btn-custom { background: #00aeef; color: white; font-weight: 600; padding: 10px; border-radius: 8px; width: 100%; border: none; transition: 0.3s; }
        .btn-custom:hover { background: #0095cc; color: white; }
    </style>
</head>
<body>

    <div class="gf-card">
        <a href="/" class="brand">Gap<span>Finder</span></a>
        <h5 class="fw-bold mb-3 text-center" style="font-family: 'Montserrat', sans-serif; color: #162622;">Change Password</h5>
        <p class="text-muted text-center mb-4" style="font-size: 0.9rem;">Identity verified. Please enter your current password and choose a new secure password.</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2" role="alert" style="font-size: 0.85rem;"><%= error %></div>
        <% } %>

        <form action="/auth/security/update" method="POST">
            <div class="mb-3">
                <label for="currentPassword" class="form-label fw-medium" style="font-size: 0.9rem;">Current Password</label>
                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required autofocus>
            </div>

            <div class="mb-3">
                <label for="newPassword" class="form-label fw-medium" style="font-size: 0.9rem;">New Password</label>
                <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                <div class="form-text" style="font-size: 0.75rem;">Must be 8+ chars with uppercase, lowercase, number, and special character.</div>
            </div>

            <div class="mb-4">
                <label for="confirmNewPassword" class="form-label fw-medium" style="font-size: 0.9rem;">Confirm New Password</label>
                <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" required>
            </div>

            <button type="submit" class="btn btn-custom mb-3">Update Password</button>
            <div class="text-center">
                <a href="/profile/security" class="text-muted text-decoration-none" style="font-size: 0.85rem;"><i class="fa-solid fa-arrow-left me-1"></i> Cancel</a>
            </div>
        </form>
    </div>

</body>
</html>
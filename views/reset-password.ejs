<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GapFinder | Reset Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* Inherits exact GapFinder styling */
        body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; color: #333; }
        .navbar-custom { background: white; padding: 20px 5%; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .brand { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: #162622; font-weight: 700; display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand span { color: #00aeef; }
        .nav-links a { color: #555; font-weight: 500; text-decoration: none; margin-left: 15px; }
        .nav-links a:hover { color: #00aeef; }
        .reset-container { margin-top: 60px; margin-bottom: 60px; }
        .gf-card { background: white; border-radius: 15px; padding: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.08); border: 1px solid #f0f2f5; }
        .gf-card h3 { font-family: 'Montserrat', sans-serif; color: #162622; font-weight: 800; }
        .form-label { font-weight: 600; color: #555; }
        .form-control { border-radius: 8px; border: 1px solid #ddd; padding: 10px 15px; }
        .form-text { font-size: 0.85rem; color: #888; }
        .btn-primary-large { background: #00aeef; color: white; padding: 12px 35px; border-radius: 10px; font-weight: 600; width: 100%; border: none; box-shadow: 0 5px 15px rgba(0,174,239,0.3); transition: 0.3s; }
        .btn-primary-large:hover { transform: translateY(-2px); background: #0095cc; color: white; }
        .password-wrapper { position: relative; }
        .password-toggle-icon { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #888; z-index: 10; }
        .password-wrapper input { padding-right: 40px; }
    </style>
</head>
<body>
    <nav class="navbar-custom">
        <a href="/" class="brand"><i class="fa-solid fa-graduation-cap" style="color: #00aeef;"></i> Gap<span>Finder</span></a>
        <div class="nav-links"><a href="/login">Cancel</a></div>
    </nav>

    <div class="container reset-container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="gf-card">
                    <h3 class="text-center mb-4">Reset Your Password</h3>
                    
                    <% if (typeof error !== 'undefined') { %>
                        <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %></div>
                    <% } %>

                    <form action="/auth/reset-password" method="POST">
                        <!-- Hidden field to pass the username to the final controller -->
                        <input type="hidden" name="username" value="<%= username %>">

                        <div class="alert alert-secondary mb-4" style="border-radius: 8px; border: 1px dashed #ccc;">
                            <strong>Security Question:</strong><br>
                            <%= securityQuestion %>
                        </div>

                        <div class="mb-3">
                            <label for="securityAnswer" class="form-label">Your Answer</label>
                            <input type="text" class="form-control" id="securityAnswer" name="securityAnswer" required>
                        </div>

                        <hr class="my-4">

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">New Password</label>
                            <div class="password-wrapper">
                                <input type="password" class="form-control" id="newPassword" name="newPassword" required pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$">
                                <i class="fa-solid fa-eye password-toggle-icon" onclick="togglePassword('newPassword', this)"></i>
                            </div>
                            <div class="form-text">Must be at least 8 characters and include 1 uppercase, 1 lowercase, 1 number, and 1 special character.</div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmNewPassword" class="form-label">Confirm New Password</label>
                            <div class="password-wrapper">
                                <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" required>
                                <i class="fa-solid fa-eye password-toggle-icon" onclick="togglePassword('confirmNewPassword', this)"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-large">Securely Reset Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>
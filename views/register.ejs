<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GapFinder | Sign Up</title>
    <!-- GapFinder Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* --- RESET & LAYOUT --- */
        body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; color: #333; line-height: 1.6; overflow-x: hidden; }
        a { text-decoration: none; }

        /* --- NAVBAR --- */
        .navbar-custom {
            background: white; padding: 20px 5%; display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); position: sticky; top: 0; z-index: 1000;
        }
        .brand { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: #162622; font-weight: 700; display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand span { color: #00aeef; }
        .nav-links { display: flex; align-items: center; gap: 15px; }
        .nav-separator { border-left: 1px solid #eee; height: 20px; margin: 0 5px; }
        .nav-links a { color: #555; font-weight: 500; transition: color 0.3s; text-decoration: none; }
        .nav-links a:hover { color: #00aeef; font-weight: 600; }
        .btn-outline { border: 2px solid #00aeef; color: #00aeef !important; padding: 8px 20px; border-radius: 8px; font-weight: 600; transition: 0.3s; }
        .btn-outline:hover { background: rgba(0, 174, 239, 0.1); }
        .btn-login { background: #00aeef; color: white !important; padding: 8px 20px; border-radius: 8px; font-weight: 600; transition: background 0.3s; }
        .btn-login:hover { background: #0095cc; box-shadow: 0 4px 10px rgba(0,174,239,0.3); }

        /* --- REGISTRATION CARD --- */
        .registration-container { margin-top: 60px; margin-bottom: 60px; }
        .gf-card {
            background: white; border-radius: 15px; padding: 40px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.08); border: 1px solid #f0f2f5;
        }
        .gf-card h3 { font-family: 'Montserrat', sans-serif; color: #162622; font-weight: 800; }
        .form-label { font-weight: 600; color: #555; }
        .form-control { border-radius: 8px; border: 1px solid #ddd; padding: 10px 15px; font-family: 'Poppins', sans-serif; }
        .form-control:focus { border-color: #00aeef; box-shadow: 0 0 0 0.25rem rgba(0, 174, 239, 0.25); }
        .form-text { font-size: 0.85rem; color: #888; }
        
        /* --- PASSWORD TOGGLE UI --- */
        .password-wrapper { position: relative; }
        .password-toggle-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #888;
            z-index: 10;
            transition: color 0.3s;
        }
        .password-toggle-icon:hover { color: #00aeef; }
        /* Add padding to the right so text doesn't type under the icon */
        .password-wrapper input { padding-right: 40px; }

        .btn-primary-large {
            background: #00aeef; color: white; padding: 12px 35px; border-radius: 10px;
            font-weight: 600; font-size: 1.1rem; width: 100%; border: none; cursor: pointer; 
            box-shadow: 0 5px 15px rgba(0,174,239,0.3); transition: transform 0.3s, background 0.3s;
        }
        .btn-primary-large:hover { transform: translateY(-2px); background: #0095cc; color: white; }

        .auth-link { color: #00aeef; font-weight: 600; text-decoration: none; transition: 0.3s; }
        .auth-link:hover { color: #0095cc; text-decoration: underline; }
        
        hr { border-color: #eee; }
        h5 { font-family: 'Montserrat', sans-serif; color: #162622; font-weight: 700; margin-top: 10px; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar-custom">
        <a href="/" class="brand">
            <i class="fa-solid fa-graduation-cap" style="color: #00aeef;"></i>
            Gap<span>Finder</span>
        </a>
        <div class="nav-links">
            <a href="/">Home</a> 
            <div class="nav-separator"></div>
            <a href="/login" class="btn-login">Log In</a>
        </div>
    </nav>

    <!-- Registration Form -->
    <div class="container registration-container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="gf-card">
                    <h3 class="text-center mb-4">Create your Account</h3>
                    
                    <!-- Generic Error Message Container -->
                    <% if (typeof error !== 'undefined') { %>
                        <div class="alert alert-danger" role="alert" style="border-radius: 8px;">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %> 
                        </div>
                    <% } %>

                    <form action="/auth/register" method="POST">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="username" name="username" placeholder="Choose a unique username" required>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <div class="password-wrapper">
                                <!-- Regex enforced on the frontend as well -->
                                <input type="password" class="form-control" id="password" name="password" placeholder="Create a strong password" required pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$" title="Must contain at least one number and one uppercase and lowercase letter, one special character, and at least 8 or more characters">
                                <i class="fa-solid fa-eye password-toggle-icon" onclick="togglePassword('password', this)"></i>
                            </div>
                            <div class="form-text">Must be at least 8 characters and include 1 uppercase, 1 lowercase, 1 number, and 1 special character.</div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <div class="password-wrapper">
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Repeat your password" required>
                                <i class="fa-solid fa-eye password-toggle-icon" onclick="togglePassword('confirmPassword', this)"></i>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h5 class="mb-3">Account Recovery</h5>
                        <!-- Predefined Security Question Dropdown -->
                        <div class="mb-3">
                            <label for="securityQuestion" class="form-label fw-medium">Security Question</label>
                            <select class="form-select" id="securityQuestion" name="securityQuestion" required>
                                <option value="" disabled selected>Select an uncommon question...</option>
                                <option value="What is the name of a college you applied to but didn't attend?">What is the name of a college you applied to but didn't attend?</option>
                                <option value="What was the name of the first school you remember attending?">What was the name of the first school you remember attending?</option>
                                <option value="Where was the destination of your most memorable school field trip?">Where was the destination of your most memorable school field trip?</option>
                                <option value="What was your maths teacher's surname in your 8th year of school?">What was your maths teacher's surname in your 8th year of school?</option>
                                <option value="What was the name of your first stuffed toy?">What was the name of your first stuffed toy?</option>
                                <option value="What was your driving instructor's first name?">What was your driving instructor's first name?</option>
                                <option value="What was the first concert you attended?">What was the first concert you attended?</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="securityAnswer" class="form-label">Security Answer</label>
                            <div class="password-wrapper">
                                <input type="password" class="form-control" id="securityAnswer" name="securityAnswer" placeholder="Your secret answer" required>
                                <i class="fa-solid fa-eye password-toggle-icon" onclick="togglePassword('securityAnswer', this)"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-large mb-4">
                            Create Account <i class="fa-solid fa-arrow-right ms-2"></i>
                        </button>
                        
                        <div class="text-center mt-2">
                            <span style="color: #666;">Already have an account?</span> 
                            <a href="/login" class="auth-link">Log in here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Script to handle show/hide password -->
    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>
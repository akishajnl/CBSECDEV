<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GapFinder | Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* Inherits exact GapFinder styling from login/register */
        body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; color: #333; }
        .navbar-custom { background: white; padding: 20px 5%; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .brand { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: #162622; font-weight: 700; display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand span { color: #00aeef; }
        .nav-links a { color: #555; font-weight: 500; text-decoration: none; margin-left: 15px; }
        .nav-links a:hover { color: #00aeef; }
        .reset-container { margin-top: 80px; margin-bottom: 60px; }
        .gf-card { background: white; border-radius: 15px; padding: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.08); border: 1px solid #f0f2f5; }
        .gf-card h3 { font-family: 'Montserrat', sans-serif; color: #162622; font-weight: 800; }
        .form-label { font-weight: 600; color: #555; }
        .form-control { border-radius: 8px; border: 1px solid #ddd; padding: 10px 15px; }
        .form-control:focus { border-color: #00aeef; box-shadow: 0 0 0 0.25rem rgba(0, 174, 239, 0.25); }
        .btn-primary-large { background: #00aeef; color: white; padding: 12px 35px; border-radius: 10px; font-weight: 600; width: 100%; border: none; box-shadow: 0 5px 15px rgba(0,174,239,0.3); transition: 0.3s; }
        .btn-primary-large:hover { transform: translateY(-2px); background: #0095cc; color: white; }
    </style>
</head>
<body>
    <nav class="navbar-custom">
        <a href="/" class="brand"><i class="fa-solid fa-graduation-cap" style="color: #00aeef;"></i> Gap<span>Finder</span></a>
        <div class="nav-links"><a href="/login">Back to Login</a></div>
    </nav>

    <div class="container reset-container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="gf-card">
                    <h3 class="text-center mb-3">Account Recovery</h3>
                    <p class="text-center text-muted mb-4">Enter your username to retrieve your security question.</p>
                    
                    <% if (typeof error !== 'undefined') { %>
                        <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %></div>
                    <% } %>

                    <form action="/auth/verify-username" method="POST">
                        <div class="mb-4">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="username" name="username" required>
                        </div>
                        <button type="submit" class="btn-primary-large">Next Step <i class="fa-solid fa-arrow-right ms-2"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>